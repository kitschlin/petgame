# 复制为 .env 并填入自己的 key（.env 已加入 .gitignore，不会提交）
DEEPSEEK_API_KEY=

# 以下都有默认值，按需修改
# COACH_MODEL=deepseek-flash
# COACH_BASE_URL=https://api.deepseek.com
# COACH_TIMEOUT=20             # 选将、复盘讲解、培养建议的单次请求超时（秒）
# COACH_FAST_TIMEOUT=8         # 战斗指导的单次请求超时（秒）
# PETARENA_COACH=live          # off / fake / live；不设置时有 key 为 live，否则 off
# COACH_WORKERS=16             # 推演用几个进程（现场推演、对局结束后的后台推演）；默认 CPU 核数 − 1，最多 16

# COACH_SEED=on                # 用不用内置经验（离线普查过的「照指导出招」对智能对手的战绩）；off 时新玩家的第 1 局只有对阵表可看
# COACH_GROWTH=light           # 培养建议：light 只按台阶给方向（不做模拟，立刻就有）/ full 逐项模拟，给出带胜算的路线

# 对局结束后的后台工作（入库、定向推演、讲解）。机器核数少时可以调小预算
# COACH_REFLECT=background     # background 后台线程 / sync 当场跑完 / off 只在打开复盘页时分析
# COACH_REFLECT_GAMES=160      # 每场对局之后定向推演最多打多少局
# COACH_GROWTH_TARGET=0.6      # 目标胜率：最好的阵容也到不了它，复盘的结论就是「属性底子不够」
# COACH_GROWTH_GAMES=120       # 只在 COACH_GROWTH=full 时用：培养方案粗筛，每个候选对每套对手阵容打几局（常规打法，便宜）
# COACH_GROWTH_VERIFY=48       # 只在 COACH_GROWTH=full 时用：培养方案决选，每个候选一共打几局（照指导出招，贵）；0 表示只粗筛
# COACH_ADVICE_ROLLOUTS=24     # 战斗指导时每个合法动作推演几局
# COACH_REVIEW_ROLLOUTS=24     # 复盘时每个合法动作推演几局
